// ==========================================================
// RÔLES UTILISATEURS
// ==========================================================

export const USER_ROLES = {
  ADMIN: "admin",
  SALES: "sales_agent",
  SAV: "sav_agent",
  CLIENT: "client"
};

// ==========================================================
// DASHBOARD PAR RÔLE
// ==========================================================

export const ROLE_DASHBOARD_PATHS = {
  admin: "/admin",
  sales_agent: "/sales",
  sav_agent: "/sav",
  client: "/dashboard"
};

// ==========================================================
// RÉCUPÉRER LE DASHBOARD D'UN UTILISATEUR
// ==========================================================
// Permet d'éviter de répéter des conditions du type :
// if (user.role === "admin") ...
// dans les différents composants.
// ==========================================================

export const getDashboardPath = (role) => {
  return ROLE_DASHBOARD_PATHS[role] || "/dashboard";
};